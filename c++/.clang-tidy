---
# We prefer to enable useful checks one by one.
Checks: >
  -*,
  modernize-use-nullptr,
  readability-inconsistent-ifelse-braces,
  custom-arrayptr-as-bytes,
  custom-arrayptr-first-copyfrom,
  custom-arrayptr-singleton,
  custom-arrayptr-slice-zero,
  custom-uninitialized-array,
  custom-use-rc-arc-deref


HeaderFilterRegex: '.*'
WarningsAsErrors: '*'


####
# Custom checks.
#
# These checks enforce custom KJ code style and idiomatic code. We recommend to enable these
# in all projects that use KJ.
#
# Requires clang-tidy's --experimental-custom-checks flag.
#
# References:
# - https://clang.llvm.org/extra/clang-tidy/QueryBasedCustomChecks.html
# - https://clang.llvm.org/docs/LibASTMatchersReference.html
CustomChecks:
  - Name: arrayptr-slice-zero
    Query: |
      match cxxMemberCallExpr(
        callee(cxxMethodDecl(
          hasName("slice"),
          ofClass(classTemplateSpecializationDecl(hasName("::kj::ArrayPtr")))
        )),
        argumentCountIs(2),
        hasArgument(0, ignoringParenImpCasts(integerLiteral(equals(0))))
      ).bind("call")
    Diagnostic:
      - BindName: call
        Message: "use first() instead of slice(0, ...)"
        Level: Warning

  - Name: arrayptr-as-bytes
    Query: |
      match cxxMemberCallExpr(
        on(ignoringImplicit(expr(anyOf(
          callExpr(
            callee(functionDecl(hasName("kj::arrayPtr")))
          ).bind("arrayPtr"),
          cxxConstructExpr(
            hasDeclaration(cxxConstructorDecl(
              ofClass(classTemplateSpecializationDecl(hasName("::kj::ArrayPtr")))
            ))
          ).bind("arrayPtr")
        )))),
        callee(cxxMethodDecl(hasName("asBytes")))
      ).bind("asBytes")
    Diagnostic:
      - BindName: asBytes
        Message: ArrayPtr construction followed by asBytes() can be simplified to kj::asBytes()
        Level: Warning

  - Name: arrayptr-first-copyfrom
    Query: |
      match cxxMemberCallExpr(
        callee(cxxMethodDecl(
          hasName("copyFrom"),
          ofClass(classTemplateSpecializationDecl(hasName("::kj::ArrayPtr")))
        )),
        argumentCountIs(1),
        on(ignoringImplicit(cxxMemberCallExpr(
          callee(cxxMethodDecl(
            hasName("first"),
            ofClass(classTemplateSpecializationDecl(hasName("::kj::ArrayPtr")))
          ))
        )))
      ).bind("copyFrom")
    Diagnostic:
      - BindName: copyFrom
        Message: replace first(...).copyFrom(value) with write(value)
        Level: Warning

  - Name: arrayptr-singleton
    Query: |
      match callExpr(
        callee(functionDecl(hasName("kj::arrayPtr"))),
        argumentCountIs(2),
        hasArgument(0, unaryOperator(hasOperatorName("&"))),
        hasArgument(1, integerLiteral(equals(1)))
      ).bind("arrayPtr")
    Diagnostic:
      - BindName: arrayPtr
        Message: kj::arrayPtr(&, 1) can be simplified to kj::arrayPtr(item)
        Level: Warning
        
  - Name: use-rc-arc-deref
    Query: |
      match unaryOperator(
        hasOperatorName("*"),
        hasUnaryOperand(ignoringParenImpCasts(cxxMemberCallExpr(
          callee(cxxMethodDecl(hasName("get"))),
          on(expr(hasType(qualType(hasDeclaration(
            classTemplateSpecializationDecl(hasAnyName("::kj::Rc", "::kj::Arc"))
          )))))
        )))
      ).bind("deref")
    Diagnostic:
      - BindName: deref
        Message: use operator* instead of dereferencing Rc::get() or Arc::get()
        Level: Warning

  # Uninitialized stack arrays may leak stale stack contents (other requests' data, return
  # addresses) if any code path reads them before writing. Initialize them with `{}`, even when
  # the next line "obviously" overwrites them. Arrays with static or thread storage duration are
  # zero-initialized anyway. KJ_STACK_ARRAY value-initializes its elements, while every use of
  # KJ_STACK_ARRAY_UNINITIALIZED is reported and must be justified with a NOLINT comment.
  - Name: uninitialized-array
    Query: |
      let uninitializedArray varDecl(
        hasType(hasCanonicalType(constantArrayType())),
        hasAutomaticStorageDuration(),
        unless(hasInitializer(anything()))
      )
      match varDecl(
        uninitializedArray,
        unless(isExpandedFromMacro("KJ_STACK_ARRAY_UNINITIALIZED"))
      ).bind("decl")
      match varDecl(
        uninitializedArray,
        isExpandedFromMacro("KJ_STACK_ARRAY_UNINITIALIZED")
      ).bind("stackArray")
    Diagnostic:
      - BindName: decl
        Message: "uninitialized arrays are a potential security risk, initialize with `{}`"
        Level: Warning
      - BindName: stackArray
        Message: >-
          KJ_STACK_ARRAY_UNINITIALIZED is a potential security risk, use KJ_STACK_ARRAY or
          explain with NOLINT why it is necessary and safe
        Level: Warning
